<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
      
      .cal-cell {
        min-height: 80px;
        padding: 4px;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        background-color: white;
        transition: transform 0.1s;
      }
      .cal-cell:hover { z-index: 10; transform: scale(1.05); box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
      .week-header { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; text-align: center; font-size: 0.75rem; font-weight: bold; color: #9ca3af; margin-bottom: 0.5rem; text-transform: uppercase; }
      .month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; margin-bottom: 2rem; }
      .nav-item.active { background-color: #e0f2fe; color: #0284c7; border-right: 4px solid #0284c7; }
      button.nav-item { text-align: left; width: 100%; border: none; cursor: pointer; }
      .fade-in { animation: fadeIn 0.3s ease-in-out; }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
      
      /* Ampulheta Girando */
      @keyframes spin-slow { 100% { transform: rotate(360deg); } }
      .animate-spin-slow { animation: spin-slow 2s linear infinite; }
    </style>
  </head>
  <body class="h-screen flex overflow-hidden">

    <div id="custom-modal" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center fade-in backdrop-blur-sm">
      <div class="bg-white rounded-xl shadow-2xl w-96 p-6 transform transition-all">
        <div class="flex items-center gap-3 mb-4" id="modal-header-container">
           <span id="modal-icon" class="material-symbols-outlined text-3xl">info</span>
           <h3 id="modal-title" class="text-xl font-bold text-gray-800">Aviso</h3>
        </div>
        <p id="modal-message" class="text-gray-600 mb-6 text-sm"></p>
        <div id="modal-actions" class="flex justify-end gap-3">
        </div>
      </div>
    </div>

    <div id="rotina-modal" class="hidden fixed inset-0 bg-black/60 z-[100] flex items-center justify-center fade-in backdrop-blur-sm">
      <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-all">
        <div class="flex items-center justify-between mb-4 border-b pb-3">
           <h3 class="text-xl font-bold text-gray-800 flex items-center gap-2">
             <span class="material-symbols-outlined text-blue-600">event_note</span> Nova Rotina
           </h3>
           <button onclick="closeRotinaModal()" class="text-gray-400 hover:text-red-500 transition">
             <span class="material-symbols-outlined">close</span>
           </button>
        </div>
        <form id="form-rotina" onsubmit="handleRotina(event)" class="flex flex-col gap-4">
           <div>
             <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Título da Rotina</label>
             <input type="text" name="titulo" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500" placeholder="Ex: Reunião de Alinhamento" required>
           </div>
           <div class="grid grid-cols-2 gap-4">
             <div>
               <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Data</label>
               <input type="date" name="dataRotina" id="input-data-rotina" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500" required>
             </div>
             <div>
               <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Início</label>
               <input type="time" name="horaInicio" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500" required>
             </div>
           </div>
           
           <div class="grid grid-cols-2 gap-4">
             <div>
                <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Prioridade</label>
                <select name="prioridade" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500 text-sm">
                  <option value="1 Máxima">🔴 1 Máxima</option>
                  <option value="2 Normal" selected>🔵 2 Normal</option>
                  <option value="3 Secundária">🟢 3 Secundária</option>
                </select>
             </div>
             <div>
                <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Repetição</label>
                <select name="recorrencia" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500 text-sm" onchange="document.getElementById('div-data-fim-modal').style.display = this.value === 'none' ? 'none' : 'block'">
                  <option value="none">Não Repete</option>
                  <option value="daily">Diária</option>
                  <option value="weekly">Semanal</option>
                  <option value="monthly">Mensal</option>
                </select>
             </div>
           </div>
           
           <div id="div-data-fim-modal" style="display: none;">
              <label class="block text-xs font-bold text-gray-700 mb-1 uppercase">Até Quando?</label>
              <input type="date" name="dataFim" class="w-full p-2.5 border rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500">
           </div>
           
           <div class="flex justify-end gap-3 mt-4 pt-4 border-t">
             <button type="button" onclick="closeRotinaModal()" class="px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm font-semibold transition">Cancelar</button>
             <button type="submit" class="px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded-lg text-sm font-semibold flex items-center gap-2 transition">
               <span class="material-symbols-outlined text-sm">save</span> Salvar Rotina
             </button>
           </div>
        </form>
      </div>
    </div>

    <div id="loader" class="hidden absolute inset-0 bg-white/80 z-50 flex items-center justify-center flex-col backdrop-blur-sm">
      <span class="material-symbols-outlined text-blue-600 animate-spin-slow" style="font-size: 56px;">hourglass_empty</span>
      <p class="text-blue-600 font-bold mt-3 tracking-widest uppercase text-sm">Processando...</p>
    </div>

    <aside class="w-64 bg-white shadow-lg flex flex-col justify-between z-10 hidden md:flex">
      <div>
        <div class="h-20 flex items-center justify-center border-b border-gray-100">
          <h1 class="text-xl font-bold text-gray-800 tracking-tight">Gestão <span class="text-blue-600">N2</span> CS</h1>
        </div>
        <nav class="mt-6 space-y-1">
          <button onclick="showSection('dashboard')" id="nav-dashboard" class="nav-item active flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition">
            <span class="material-symbols-outlined mr-3">analytics</span> Analítico
          </button>
          <button onclick="showSection('atendimentos')" id="nav-atendimentos" class="nav-item flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition">
            <span class="material-symbols-outlined mr-3">support_agent</span> Atendimentos
          </button>
          <button onclick="showSection('rotinas')" id="nav-rotinas" class="nav-item flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition">
            <span class="material-symbols-outlined mr-3">calendar_month</span> Rotinas & Cal.
          </button>
          <button onclick="showSection('colaborador')" id="nav-colaborador" class="nav-item flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition">
            <span class="material-symbols-outlined mr-3">person_add</span> Novo Colaborador
          </button>
        </nav>
      </div>
      <div class="p-4">
        <div class="bg-blue-50 rounded-lg p-4">
          <p class="text-xs text-blue-600 font-semibold uppercase">Status SLA</p>
          <div class="flex items-end mt-1"><span class="text-2xl font-bold text-blue-900" id="sla-display">--%</span><span class="text-xs text-blue-500 mb-1 ml-1">Meta: 90%</span></div>
          <div class="w-full bg-blue-200 h-1.5 rounded-full mt-2"><div class="bg-blue-600 h-1.5 rounded-full" style="width: 90%"></div></div>
        </div>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-8 relative">

      <section id="dashboard" class="fade-in space-y-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">📊 Visão Geral da Operação</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100"><p class="text-sm font-medium text-gray-500">Total Atendimentos</p><h3 class="text-3xl font-bold text-gray-800 mt-1" id="kpi-total">0</h3></div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100"><p class="text-sm font-medium text-gray-500">TMA Geral</p><h3 class="text-3xl font-bold text-gray-800 mt-1"><span id="kpi-tma">0</span> min</h3></div>
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100"><p class="text-sm font-medium text-gray-500">SLA Rotinas</p><h3 class="text-3xl font-bold text-gray-800 mt-1">92%</h3></div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100"><h4 class="text-lg font-semibold text-gray-700 mb-4">Principais Dúvidas</h4><div class="relative h-64"><canvas id="chart-categorias"></canvas></div></div>
        </div>
      </section>

      <section id="atendimentos" class="hidden fade-in max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">🎧 Registro de Atendimento</h2>
        <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
          <form id="form-atendimento" onsubmit="handleAtendimento(event)">
            <div class="grid grid-cols-2 gap-6 mb-4">
              <div><label class="block text-sm font-medium text-gray-700 mb-1">Solicitante</label><select id="input-solicitante" class="w-full p-2.5 border rounded-lg bg-gray-50"><option value="">Carregando...</option></select></div>
              <div><label class="block text-sm font-medium text-gray-700 mb-1">Sistema</label><select name="sistema" class="w-full p-2.5 border rounded-lg bg-gray-50"><option>KOMUNIC</option><option>ACESSÓRIAS</option><option>AC DOC'S</option><option>OUTROS</option></select></div>
            </div>
            <div class="grid grid-cols-2 gap-6 mb-4">
              <div><label class="block text-sm font-medium text-gray-700 mb-1">Categoria</label><select name="categoria" class="w-full p-2.5 border rounded-lg bg-gray-50"><option>Dúvida Técnica</option><option>Login / Acesso</option><option>Bug / Erro</option><option>Dúvida de Processo</option></select></div>
              <div><label class="block text-sm font-medium text-gray-700 mb-1">Tempo (min)</label><input type="number" name="tempo" class="w-full p-2.5 border rounded-lg bg-gray-50" required></div>
            </div>
            <div class="mb-6"><label class="block text-sm font-medium text-gray-700 mb-1">Descrição</label><textarea name="descricao" rows="3" class="w-full p-2.5 border rounded-lg bg-gray-50"></textarea></div>
            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 flex justify-center gap-2"><span class="material-symbols-outlined">save</span> Registrar</button>
          </form>
        </div>
      </section>

      <section id="colaborador" class="hidden fade-in max-w-lg mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">👥 Onboarding Sistêmico</h2>
        <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100">
          <form id="form-colaborador" onsubmit="handleColaborador(event)">
            <div class="mb-4"><label class="block text-sm font-medium text-gray-700 mb-1">Nome</label><input type="text" name="nome" class="w-full p-2.5 border rounded-lg bg-gray-50" required></div>
            <div class="mb-6"><label class="block text-sm font-medium text-gray-700 mb-1">Equipe</label><select name="equipe" id="input-equipe" class="w-full p-2.5 border rounded-lg bg-gray-50"><option value="">Carregando...</option></select></div>
            <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700">Cadastrar</button>
          </form>
        </div>
      </section>

      <section id="rotinas" class="hidden fade-in h-full flex flex-col">
        
        <div class="flex flex-wrap justify-between items-center mb-4 gap-4 bg-white p-4 rounded-xl shadow-sm border border-gray-100">
          <div class="flex items-center gap-4">
            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2"><span class="material-symbols-outlined text-blue-600">calendar_month</span> Calendário</h2>
            <div class="flex items-center bg-gray-50 rounded-lg border border-gray-200 p-1">
              <button onclick="changeMonth(-1)" class="p-1 hover:bg-white rounded text-gray-600"><span class="material-symbols-outlined">chevron_left</span></button>
              <button onclick="changeMonth(1)" class="p-1 hover:bg-white rounded text-gray-600"><span class="material-symbols-outlined">chevron_right</span></button>
            </div>
          </div>
          
          <div class="bg-blue-50 px-4 py-2 rounded-lg border border-blue-100 flex items-center gap-3">
            <span class="material-symbols-outlined text-blue-600 text-3xl">timer</span>
            <div class="flex flex-col">
              <span class="text-[10px] uppercase font-bold text-blue-500 leading-none">Tempo Gasto (Visão)</span>
              <span id="total-time-display" class="text-lg font-bold text-blue-900 leading-tight">0h 0m</span>
            </div>
          </div>

          <div class="flex gap-2">
            <select id="filter-period" onchange="renderCalendar()" class="p-2 border rounded-lg text-sm bg-gray-50 text-gray-700 outline-none font-semibold">
              <option value="month">📅 Mensal</option>
              <option value="quarter">📊 Trimestral</option>
              <option value="semester">📈 Semestral</option>
              <option value="year">📆 Anual</option>
            </select>
            
            <select id="filter-equipe" onchange="renderCalendar()" class="p-2 border rounded-lg text-sm bg-gray-50 text-gray-700 outline-none w-40">
              <option value="all">🏢 T. Equipes</option>
            </select>

            <select id="filter-collab" onchange="renderCalendar()" class="p-2 border rounded-lg text-sm bg-gray-50 text-gray-700 outline-none w-40">
              <option value="all">👥 T. Colab</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 overflow-hidden min-h-[600px]">
          
          <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex flex-col h-full overflow-y-auto" id="calendar-wrapper">
             </div>

          <div class="bg-white rounded-xl shadow-sm border border-gray-100 flex flex-col overflow-hidden h-full">
             
             <div class="p-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
               <div>
                 <h3 class="text-xs font-bold text-gray-500 uppercase">Resumo do Dia</h3>
                 <p id="selected-date-display" class="text-xl font-bold text-blue-900 mt-1">Selecione um dia</p>
               </div>
               <button onclick="openRotinaModal()" class="bg-blue-600 text-white px-3 py-1.5 rounded-lg hover:bg-blue-700 text-xs font-bold flex items-center gap-1 transition shadow-sm">
                 <span class="material-symbols-outlined text-sm">add</span> Nova Rotina
               </button>
             </div>
             
             <div id="day-details-list" class="flex-1 overflow-y-auto p-0 flex flex-col">
               
               <div class="flex-1 bg-red-50/30 p-4 border-b border-red-100 flex flex-col">
                  <h4 class="text-xs font-bold text-red-600 uppercase mb-3 flex items-center">
                    <span class="material-symbols-outlined text-sm mr-1">pending_actions</span> Em Aberto
                  </h4>
                  <div id="list-open" class="space-y-2 flex-1">
                    <p class="text-xs text-gray-400 italic">Nenhuma pendência.</p>
                  </div>
               </div>

               <div class="flex-1 bg-green-50/30 p-4 flex flex-col">
                  <h4 class="text-xs font-bold text-green-600 uppercase mb-3 flex items-center">
                    <span class="material-symbols-outlined text-sm mr-1">check_circle</span> Concluídos
                  </h4>
                  <div id="list-done" class="space-y-2 flex-1">
                    <p class="text-xs text-gray-400 italic">Nenhum registro concluído.</p>
                  </div>
               </div>

             </div>
          </div>
        </div>
      </section>

    </main>

    <script>
      let currentDate = new Date();
      let selectedDateObj = new Date(); 
      let calendarEventsCache = [];
      let holidays = ["01/01", "21/04", "01/05", "07/09", "12/10", "02/11", "15/11", "25/12"]; 

      const ITEMS_PER_PAGE = 5;
      let currentPageOpen = 1;
      let currentPageDone = 1;
      let currentEventsOpen = [];
      let currentEventsDone = [];

      let notifiedEvents = new Set();
      let audioCtx = null;

      window.onload = function() {
        renderCalendar();
        loadColaboradores();
        loadEquipes();
        loadDashboard();
        loadCalendarEvents();
        
        if ("Notification" in window && Notification.permission !== "granted" && Notification.permission !== "denied") {
          Notification.requestPermission();
        }
        setInterval(checkAlarms, 10000); 
      };

      document.addEventListener('click', () => {
        if(!audioCtx) {
           const AudioContext = window.AudioContext || window.webkitAudioContext;
           if(AudioContext) audioCtx = new AudioContext();
        }
        if(audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      }, { once: true });

      function playNotificationSound() {
        try {
          if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const osc = audioCtx.createOscillator();
          const gainNode = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, audioCtx.currentTime); 
          osc.frequency.exponentialRampToValueAtTime(440, audioCtx.currentTime + 0.3);
          gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
          osc.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        } catch(e) { console.log("Áudio não suportado ou bloqueado pelo navegador."); }
      }

      function checkAlarms() {
        if (!calendarEventsCache || calendarEventsCache.length === 0) return;
        
        let now = new Date();
        let todayIso = now.getFullYear() + '-' + ('0'+(now.getMonth()+1)).slice(-2) + '-' + ('0'+now.getDate()).slice(-2);
        let currentTimeStr = ('0'+now.getHours()).slice(-2) + ':' + ('0'+now.getMinutes()).slice(-2);

        calendarEventsCache.forEach(ev => {
          if (ev.status !== "Concluído" && ev.dateIso === todayIso && ev.time === currentTimeStr && ev.type === "Rotina") {
             if (!notifiedEvents.has(ev.id)) {
                 notifiedEvents.add(ev.id); 
                 playNotificationSound(); 
                 
                 if ("Notification" in window && Notification.permission === "granted") {
                     new Notification("🚨 Alerta de Rotina!", {
                         body: `Hora de realizar: "${ev.title}" (Programado para ${ev.time} - Prioridade: ${ev.priority})`,
                         icon: "https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/notifications_active/default/24px.svg"
                     });
                 } else {
                     showModal("🚨 Alerta de Rotina!", `A rotina "${ev.title}" está programada para agora (${ev.time})!`, 'alert');
                 }
             }
          }
        });
      }

      // MODAIS GERAIS
      function showLoader() { document.getElementById('loader').classList.remove('hidden'); }
      function hideLoader() { document.getElementById('loader').classList.add('hidden'); }

      function showModal(title, message, type, confirmCallback) {
        document.getElementById('modal-title').innerText = title;
        document.getElementById('modal-message').innerText = message;
        
        const modalIcon = document.getElementById('modal-icon');
        const actions = document.getElementById('modal-actions');
        actions.innerHTML = '';
        
        if (type === 'confirm') {
          modalIcon.innerText = "help_outline";
          modalIcon.className = "material-symbols-outlined text-3xl text-orange-500";
          
          const btnCancel = document.createElement('button');
          btnCancel.className = "px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm font-semibold transition";
          btnCancel.innerText = "Cancelar";
          btnCancel.onclick = () => document.getElementById('custom-modal').classList.add('hidden');
          
          const btnConfirm = document.createElement('button');
          btnConfirm.className = "px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded-lg text-sm font-semibold transition";
          btnConfirm.innerText = "Sim, Concluir";
          btnConfirm.onclick = () => {
            document.getElementById('custom-modal').classList.add('hidden');
            if(confirmCallback) confirmCallback();
          };
          
          actions.appendChild(btnCancel);
          actions.appendChild(btnConfirm);
        } else {
          modalIcon.innerText = title.includes('Erro') ? "error" : "check_circle";
          modalIcon.className = title.includes('Erro') ? "material-symbols-outlined text-3xl text-red-500" : (title.includes('Alerta') ? "material-symbols-outlined text-3xl text-orange-500" : "material-symbols-outlined text-3xl text-green-500");

          const btnOk = document.createElement('button');
          btnOk.className = "px-4 py-2 text-white bg-blue-600 hover:bg-blue-700 rounded-lg text-sm font-semibold transition";
          btnOk.innerText = "OK";
          btnOk.onclick = () => document.getElementById('custom-modal').classList.add('hidden');
          actions.appendChild(btnOk);
        }
        
        document.getElementById('custom-modal').classList.remove('hidden');
      }

      function openRotinaModal() {
        const dateInput = document.getElementById('input-data-rotina');
        if(dateInput && selectedDateObj) {
          dateInput.value = selectedDateObj.getFullYear() + '-' + ('0'+(selectedDateObj.getMonth()+1)).slice(-2) + '-' + ('0'+selectedDateObj.getDate()).slice(-2);
        }
        document.getElementById('rotina-modal').classList.remove('hidden');
      }

      function closeRotinaModal() {
        document.getElementById('rotina-modal').classList.add('hidden');
        document.getElementById('form-rotina').reset();
        document.getElementById('div-data-fim-modal').style.display = 'none';
      }

      function showSection(id) {
        ['dashboard','atendimentos','rotinas','colaborador'].forEach(s => {
          document.getElementById(s).classList.add('hidden');
          document.getElementById('nav-'+s).classList.remove('active','bg-blue-50','text-blue-600','border-r-4','border-blue-600');
        });
        document.getElementById(id).classList.remove('hidden');
        document.getElementById('nav-'+id).classList.add('active');
        if(id === 'rotinas') renderCalendar();
        if(id === 'dashboard') loadDashboard();
      }

      function loadColaboradores() { 
        google.script.run.withSuccessHandler(d => { 
          const s = document.getElementById('input-solicitante'); 
          const f = document.getElementById('filter-collab');
          if(s){s.innerHTML='<option value="">Selecione...</option>'; d.forEach(c=>s.add(new Option(c.nome,c.nome)));}
          if(f){f.innerHTML='<option value="all">👥 T. Colab</option>'; d.forEach(c=>f.add(new Option(c.nome,c.nome)));}
        }).getColaboradores(); 
      }
      
      function loadEquipes() { 
        google.script.run.withSuccessHandler(l => { 
          const s = document.getElementById('input-equipe'); 
          const fEq = document.getElementById('filter-equipe'); 
          if(s){s.innerHTML=''; l.forEach(i=>s.add(new Option(i,i)));} 
          if(fEq){fEq.innerHTML='<option value="all">🏢 T. Equipes</option>'; l.forEach(i=>fEq.add(new Option(i,i)));}
        }).getEquipesList(); 
      }
      
      function loadDashboard() { 
        google.script.run.withSuccessHandler(d => {
          document.getElementById('kpi-total').innerText = d.total; document.getElementById('kpi-tma').innerText = d.tma;
          const c = document.getElementById('chart-categorias'); if(c){ 
            const chart = Chart.getChart(c); if(chart) chart.destroy();
            new Chart(c, {type:'doughnut', data:{labels:Object.keys(d.categorias), datasets:[{data:Object.values(d.categorias), backgroundColor:['#3b82f6','#10b981','#f59e0b','#ef4444'], borderWidth:0}]}, options:{responsive:true, cutout:'70%'}});
          }
        }).getDashboardData(); 
      }

      function loadCalendarEvents() { 
        google.script.run.withSuccessHandler(e => { 
          calendarEventsCache = e; 
          renderCalendar(); 
          selectDay(selectedDateObj); 
        }).getCalendarEvents(); 
      }

      function handleAtendimento(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          showModal("Sucesso", r.message, 'alert');
          document.getElementById('form-atendimento').reset(); 
          loadCalendarEvents();
        }).salvarAtendimento({solicitante:document.getElementById('input-solicitante').value, sistema:e.target.sistema.value, categoria:e.target.categoria.value, tempo:e.target.tempo.value, descricao:e.target.descricao.value}); 
      }
      
      // [MELHORIA] Incluído envio da prioridade para o Back-End
      function handleRotina(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          closeRotinaModal(); 
          if(r.success){
            showModal("Sucesso", r.message, 'alert'); 
          } else {
            showModal("Aviso", r.message, 'alert'); 
          }
          loadCalendarEvents();
        }).salvarRotina({
          titulo: e.target.titulo.value, 
          dataRotina: e.target.dataRotina.value, 
          horaInicio: e.target.horaInicio.value,
          recorrencia: e.target.recorrencia.value,
          dataFim: e.target.dataFim.value,
          prioridade: e.target.prioridade.value // Captura a prioridade
        }); 
      }
      
      function handleColaborador(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          showModal("Sucesso", r.message, 'alert');
          document.getElementById('form-colaborador').reset(); 
          loadColaboradores();
        }).salvarNovoColaborador({nome:e.target.nome.value, equipe:e.target.equipe.value}); 
      }

      function markAsDone(id) {
        showModal('Confirmação', 'Você finalizou esta rotina?', 'confirm', function() {
          showLoader();
          google.script.run.withSuccessHandler(function(res) {
            hideLoader();
            if(res.success) {
              loadCalendarEvents(); 
            } else {
              showModal('Erro', "Falha: " + res.message, 'alert');
            }
          }).concluirRotina(id);
        });
      }

      function changeMonth(step) {
        const period = document.getElementById('filter-period').value;
        let jump = 1;
        if(period === 'quarter') jump = 3;
        if(period === 'semester') jump = 6;
        if(period === 'year') jump = 12;
        currentDate.setMonth(currentDate.getMonth() + (step * jump));
        renderCalendar();
      }

      function renderCalendar() {
        const wrapper = document.getElementById('calendar-wrapper');
        const period = document.getElementById('filter-period').value;
        const filterCollab = document.getElementById('filter-collab').value;
        const filterEquipe = document.getElementById('filter-equipe').value; 
        
        if(!wrapper) return;
        wrapper.innerHTML = ''; 

        let monthsToShow = 1;
        if(period === 'quarter') monthsToShow = 3;
        if(period === 'semester') monthsToShow = 6;
        if(period === 'year') monthsToShow = 12;

        let renderDate = new Date(currentDate); 
        const today = new Date(); today.setHours(0,0,0,0);
        
        let totalMinutesGasto = 0;

        const eventosFiltrados = calendarEventsCache.filter(ev => {
          let passCollab = (filterCollab === 'all' || ev.collaborator === filterCollab);
          let passEquipe = (filterEquipe === 'all' || ev.team === filterEquipe || ev.team === "Geral"); 
          return passCollab && passEquipe;
        });

        const eventosPorData = {};
        eventosFiltrados.forEach(ev => {
          if (!eventosPorData[ev.dateIso]) eventosPorData[ev.dateIso] = [];
          eventosPorData[ev.dateIso].push(ev);
        });

        for (let m = 0; m < monthsToShow; m++) {
           let year = renderDate.getFullYear();
           let month = renderDate.getMonth();
           
           let monthContainer = document.createElement('div');
           monthContainer.className = "mb-8";
           let monthTitle = document.createElement('h3');
           monthTitle.className = "text-lg font-bold text-gray-700 mb-2 capitalize border-b pb-1";
           monthTitle.innerText = renderDate.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
           monthContainer.appendChild(monthTitle);

           let weekHeader = document.createElement('div');
           weekHeader.className = "week-header";
           ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'].forEach(d => {
             let span = document.createElement('span'); span.innerText = d; weekHeader.appendChild(span);
           });
           monthContainer.appendChild(weekHeader);

           let grid = document.createElement('div');
           grid.className = "month-grid";
           
           let firstDay = new Date(year, month, 1);
           let lastDay = new Date(year, month + 1, 0);

           for(let i=0; i<firstDay.getDay(); i++) { let empty = document.createElement('div'); grid.appendChild(empty); }

           for(let i=1; i<=lastDay.getDate(); i++) {
             let dayDate = new Date(year, month, i);
             let dayStr = ('0'+i).slice(-2)+'/'+('0'+(month+1)).slice(-2);
             let dataKey = year + '-' + ('0'+(month+1)).slice(-2) + '-' + ('0'+i).slice(-2); 

             let cell = document.createElement('div');
             cell.className = "cal-cell relative";
             
             if (selectedDateObj.getDate() === i && selectedDateObj.getMonth() === month && selectedDateObj.getFullYear() === year) {
               cell.style.boxShadow = "0 0 0 2px #3b82f6";
               cell.style.transform = "scale(1.02)";
             }

             cell.onclick = () => { selectDay(dayDate); renderCalendar(); }; 

             let isHoliday = holidays.includes(dayStr);
             let isToday = dayDate.getTime() === today.getTime();
             let isWeekend = (dayDate.getDay()===0 || dayDate.getDay()===6);
             let isFuture = dayDate > today;
             
             let isPast = dayDate.getTime() < today.getTime();

             let events = eventosPorData[dataKey] || [];
             let hasOpen = events.some(e => e.status !== "Concluído");
             let hasDone = events.some(e => e.status === "Concluído");
             
             let isPastPending = isPast && hasOpen; 

             if (isPastPending) {
               cell.style.border = "2px solid #ef4444"; 
               cell.style.backgroundColor = "#fef2f2"; 
               cell.style.color = "#b91c1c"; 
               cell.innerHTML = `<b class="flex justify-between items-center">${i} <span class="text-red-600 text-lg leading-none font-black animate-pulse" title="Pendência Atrasada!">!</span></b>`; 
             }
             else if(isHoliday) { cell.style.border = "2px solid #fbbf24"; cell.style.color = "#d97706"; cell.innerHTML = `<b>${i} ★</b>`; } 
             else if(isToday) { cell.style.backgroundColor = "#bfdbfe"; cell.style.border = "2px solid #3b82f6"; cell.style.color = "#1e3a8a"; cell.innerHTML = `<b>${i}</b>`; } 
             else if(isWeekend) { cell.style.backgroundColor = "#e5e7eb"; cell.style.color = "#9ca3af"; cell.style.pointerEvents = "none"; cell.innerHTML = `<b>${i}</b>`; } 
             else if(isFuture) { cell.style.backgroundColor = "#1e3a8a"; cell.style.color = "white"; cell.innerHTML = `<b>${i}</b>`; } 
             else { cell.style.color = "#6b7280"; cell.innerHTML = `<b>${i}</b>`; }

             if(events.length > 0) {
               let totalDay = events.length;
               let doneDay = events.filter(e => e.status === "Concluído").length;
               
               events.forEach(ev => {
                 if(ev.status === "Concluído" && ev.duration) {
                   totalMinutesGasto += ev.duration;
                 }
               });

               let footerContainer = document.createElement('div');
               footerContainer.className = "flex justify-between items-end mt-auto";

               let dots = document.createElement('div'); 
               dots.className = "flex gap-1 flex-wrap";
               if(hasDone) dots.innerHTML += `<div class="w-2 h-2 rounded-full bg-green-500"></div>`;
               if(hasOpen) dots.innerHTML += `<div class="w-2 h-2 rounded-full bg-red-400"></div>`;
               
               let fraction = document.createElement('span');
               fraction.className = "text-[10px] font-bold text-gray-500 bg-gray-100 px-1 rounded";
               fraction.innerText = `${doneDay}/${totalDay}`;

               footerContainer.appendChild(dots);
               footerContainer.appendChild(fraction);
               cell.appendChild(footerContainer);
             }
             grid.appendChild(cell);
           }
           monthContainer.appendChild(grid);
           wrapper.appendChild(monthContainer);
           renderDate.setMonth(renderDate.getMonth() + 1);
        }
        
        const timeDisplay = document.getElementById('total-time-display');
        if(timeDisplay) {
          let hours = Math.floor(totalMinutesGasto / 60);
          let mins = Math.floor(totalMinutesGasto % 60);
          timeDisplay.innerText = `${hours}h ${mins}m`;
        }

        selectDay(selectedDateObj, true);
      }

      function selectDay(dateObj, isReRender = false) {
        if(!isReRender) {
           selectedDateObj = dateObj; 
        }
        
        document.getElementById('selected-date-display').innerText = dateObj.toLocaleDateString('pt-BR',{weekday:'long', day:'numeric', month:'long'});
        
        const filterCollab = document.getElementById('filter-collab').value;
        const filterEquipe = document.getElementById('filter-equipe').value; 
        
        let dateIsoTarget = dateObj.getFullYear() + '-' + ('0'+(dateObj.getMonth()+1)).slice(-2) + '-' + ('0'+dateObj.getDate()).slice(-2);

        let events = calendarEventsCache.filter(ev => {
           let passCollab = (filterCollab === 'all' || ev.collaborator === filterCollab);
           let passEquipe = (filterEquipe === 'all' || ev.team === filterEquipe || ev.team === "Geral");
           return ev.dateIso === dateIsoTarget && passCollab && passEquipe;
        });

        // Ordenar os eventos por prioridade (1 aparece primeiro)
        events.sort((a, b) => a.priority.localeCompare(b.priority));

        currentEventsDone = events.filter(e => e.status === "Concluído");
        currentEventsOpen = events.filter(e => e.status !== "Concluído");

        if(!isReRender) {
          currentPageOpen = 1;
          currentPageDone = 1;
        }

        renderOpenList();
        renderDoneList();
      }

      function changePageOpen(step) { currentPageOpen += step; renderOpenList(); }
      function changePageDone(step) { currentPageDone += step; renderDoneList(); }

      function renderOpenList() {
        const listOpen = document.getElementById('list-open');
        listOpen.innerHTML = '';

        if(currentEventsOpen.length === 0) {
          listOpen.innerHTML = '<p class="text-xs text-gray-400 italic">Nenhuma pendência.</p>';
          return;
        }

        let start = (currentPageOpen - 1) * ITEMS_PER_PAGE;
        let end = start + ITEMS_PER_PAGE;
        let paginated = currentEventsOpen.slice(start, end);

        let wrapper = document.createElement('div');
        wrapper.className = "space-y-2 mb-2";

        paginated.forEach(ev => {
          // [MELHORIA] Visual da Tag de Prioridade
          let prioColor = "bg-blue-100 text-blue-700 border-blue-200";
          if(ev.priority.includes("1")) prioColor = "bg-red-100 text-red-700 border-red-200";
          else if(ev.priority.includes("3")) prioColor = "bg-green-100 text-green-700 border-green-200";
          let prioridadeTag = `<span class="${prioColor} border text-[9px] px-1.5 py-0.5 rounded font-bold uppercase">${ev.priority}</span>`;

          let html = `
            <div class="bg-white border-l-2 border-red-500 p-2 rounded shadow-sm flex justify-between items-center group">
              <div class="flex-1">
                <p class="font-bold text-gray-800 text-sm">${ev.title}</p>
                <div class="flex justify-between text-xs text-gray-500 mt-1 items-center">
                   <div class="flex gap-2 items-center">
                     <span>${ev.time}</span> <span class="bg-gray-100 rounded px-1 hidden md:inline-block">${ev.team}</span>
                   </div>
                   ${prioridadeTag}
                </div>
              </div>
              ${ev.id ? `<button onclick="markAsDone('${ev.id}')" class="ml-2 bg-green-100 hover:bg-green-600 hover:text-white text-green-700 p-1.5 rounded-full transition shadow-sm" title="Concluir tarefa">
                <span class="material-symbols-outlined text-sm">check</span>
              </button>` : ''}
            </div>`;
           wrapper.innerHTML += html;
        });

        listOpen.appendChild(wrapper);

        if (currentEventsOpen.length > ITEMS_PER_PAGE) {
           let totalPages = Math.ceil(currentEventsOpen.length / ITEMS_PER_PAGE);
           let pagHTML = `
             <div class="flex justify-between items-center mt-auto pt-2 border-t border-red-200">
                <button onclick="changePageOpen(-1)" class="text-[10px] font-bold text-red-600 hover:underline disabled:opacity-30" ${currentPageOpen===1?'disabled':''}>◀ Anterior</button>
                <span class="text-[10px] text-gray-500">${currentPageOpen} de ${totalPages}</span>
                <button onclick="changePageOpen(1)" class="text-[10px] font-bold text-red-600 hover:underline disabled:opacity-30" ${currentPageOpen===totalPages?'disabled':''}>Próxima ▶</button>
             </div>`;
           listOpen.innerHTML += pagHTML;
        }
      }

      function renderDoneList() {
        const listDone = document.getElementById('list-done');
        listDone.innerHTML = '';

        if(currentEventsDone.length === 0) {
          listDone.innerHTML = '<p class="text-xs text-gray-400 italic">Nenhum registro concluído.</p>';
          return;
        }

        let start = (currentPageDone - 1) * ITEMS_PER_PAGE;
        let end = start + ITEMS_PER_PAGE;
        let paginated = currentEventsDone.slice(start, end);

        let wrapper = document.createElement('div');
        wrapper.className = "space-y-2 mb-2";

        paginated.forEach(ev => {
           // [MELHORIA] Tag de Prioridade mesmo em tarefas concluídas (opacidade reduzida)
           let prioColor = "bg-gray-100 text-gray-500 border-gray-200";
           if(ev.priority.includes("1")) prioColor = "bg-red-50 text-red-400 border-red-100";
           else if(ev.priority.includes("3")) prioColor = "bg-green-50 text-green-500 border-green-100";
           let prioridadeTag = `<span class="${prioColor} border text-[9px] px-1.5 py-0.5 rounded font-bold uppercase">${ev.priority}</span>`;

           let html = `
            <div class="bg-white border p-2 rounded shadow-sm opacity-75">
              <p class="font-bold text-gray-800 text-sm line-through">${ev.title}</p>
              <div class="flex justify-between text-xs text-gray-500 mt-1 items-center">
                 <div class="flex gap-2 items-center">
                   <span>${ev.time}</span><span class="hidden md:inline-block">${ev.collaborator}</span>
                 </div>
                 ${prioridadeTag}
              </div>
            </div>`;
           wrapper.innerHTML += html;
        });

        listDone.appendChild(wrapper);

        if (currentEventsDone.length > ITEMS_PER_PAGE) {
           let totalPages = Math.ceil(currentEventsDone.length / ITEMS_PER_PAGE);
           let pagHTML = `
             <div class="flex justify-between items-center mt-auto pt-2 border-t border-green-200">
                <button onclick="changePageDone(-1)" class="text-[10px] font-bold text-green-600 hover:underline disabled:opacity-30" ${currentPageDone===1?'disabled':''}>◀ Anterior</button>
                <span class="text-[10px] text-gray-500">${currentPageDone} de ${totalPages}</span>
                <button onclick="changePageDone(1)" class="text-[10px] font-bold text-green-600 hover:underline disabled:opacity-30" ${currentPageDone===totalPages?'disabled':''}>Próxima ▶</button>
             </div>`;
           listDone.innerHTML += pagHTML;
        }
      }
    </script>
  </body>
</html>
