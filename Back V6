}

// Salvar Rotina com Suporte à Recorrência
function salvarRotina(form) {
  try {
    var sheet = getSheetByKey("ROTINAS_PLANEJADAS");
    
    var baseDate = new Date(form.dataRotina + 'T12:00:00');
    var endDate = form.dataFim ? new Date(form.dataFim + 'T12:00:00') : baseDate;
    var recorrencia = form.recorrencia || "none";
    var prioridade = form.prioridade || "2 Normal"; 
    
    var maxExecutions = 365;
    var execCount = 0;
    
    var currentDate = new Date(baseDate);
    var rowsToAppend = [];
    
    var feriados = ["01/01", "21/04", "01/05", "07/09", "12/10", "02/11", "15/11", "25/12"];
    
    while (currentDate <= endDate && execCount <= maxExecutions) {
      var d = new Date(currentDate);
      
      var isWeekend = (d.getDay() === 0 || d.getDay() === 6);
      var dayStr = ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2);
      var isHoliday = feriados.indexOf(dayStr) !== -1;
      
      if (!isWeekend && !isHoliday) {
        var dateStr = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
        rowsToAppend.push([dateStr, form.titulo, form.horaInicio, "", "", "Pendente", Utilities.getUuid(), prioridade]);
      }
      
      if (recorrencia === "none") break;
      
      if (recorrencia === "daily") {
        currentDate.setDate(currentDate.getDate() + 1);
      } else if (recorrencia === "weekly") {
        currentDate.setDate(currentDate.getDate() + 7);
      } else if (recorrencia === "monthly") {
        currentDate.setMonth(currentDate.getMonth() + 1);
      } else {
        break;
      }
      execCount++;
    }
    
    if (rowsToAppend.length > 0) {
      sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, rowsToAppend[0].length).setValues(rowsToAppend);
      var msg = rowsToAppend.length > 1 ? rowsToAppend.length + " Rotinas agendadas em lote! 🔄📅" : "Rotina agendada! 📅";
      return { success: true, message: msg };
    } else {
      return { success: false, message: "Nenhuma rotina criada. As datas selecionadas caem em finais de semana ou feriados. 🚫" };
    }
  } catch (e) { throw new Error(e.message); }
}

function concluirRotina(id) {
  try {
    var sheet = getSheetByKey("ROTINAS_PLANEJADAS");
    var data = sheet.getDataRange().getValues();
    
    for (var i = 1; i < data.length; i++) {
      if (data[i][6] == id) {
        var row = i + 1; 
        
        var now = new Date();
        var horaFim = ('0' + now.getHours()).slice(-2) + ':' + ('0' + now.getMinutes()).slice(-2);
        sheet.getRange(row, 4).setValue(horaFim);

        var horaInicioRaw = data[i][2];
        if (horaInicioRaw) {
          var startMins = 0;
          if (horaInicioRaw instanceof Date) {
            startMins = horaInicioRaw.getHours() * 60 + horaInicioRaw.getMinutes();
          } else {
            var parts = horaInicioRaw.toString().split(':');
            startMins = parseInt(parts[0], 10) * 60 + parseInt(parts[1], 10);
          }
          var endMins = now.getHours() * 60 + now.getMinutes();
          var diff = endMins - startMins;
          if (diff < 0) diff += 24 * 60; 
          sheet.getRange(row, 5).setValue(diff);
        }
        
        sheet.getRange(row, 6).setValue("Concluído");
        
        return { success: true, message: "Rotina concluída com sucesso! ✅" };
      }
    }
    return { success: false, message: "Rotina não encontrada." };
  } catch (e) {
    throw new Error("Erro ao concluir: " + e.message);
  }
}

function getDashboardData(filters) {
  try {
    var sheetAtend = getSheetByKey("ATENDIMENTOS_REGISTRO");
    var dataAtend = sheetAtend.getDataRange().getValues();
    
    var teamMap = {};
    try {
      var colabSheet = getSheetByKey("COLABORADORES_ONGOING");
      var colabData = colabSheet.getDataRange().getValues();
      for(var c = 1; c < colabData.length; c++) {
        if(colabData[c][0]) teamMap[colabData[c][0]] = colabData[c][1];
      }
    } catch(e) {}

    if (!filters) filters = { periodo: 'all', mes: 'all', equipe: 'all', collab: 'all' };

    var totalAtendimentos = 0;
    var tempoTotal = 0;
    var categoriasCount = {};
    var sistemasCount = {};
    var subcategoriasCount = {}; // Novo mapeamento
    var colabCount = {}; // Novo mapeamento para ranking
    var hojeCount = 0;
    var now = new Date();
    var todayStr = now.toDateString();
    
    var last7Days = [];
    var evolucaoMapAtendimentos = {};
    var evolucaoMapTempo = {}; 
    
    for(var i=6; i>=0; i--) {
        var d = new Date();
        d.setDate(now.getDate() - i);
        var dStr = d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
        last7Days.push(dStr);
        evolucaoMapAtendimentos[dStr] = 0;
        evolucaoMapTempo[dStr] = 0;
    }

    for (var i = 1; i < dataAtend.length; i++) {
      var dataRow = new Date(dataAtend[i][0]);
      if (isNaN(dataRow.getTime())) continue;

      var colabName = dataAtend[i][1];
      var team = teamMap[colabName] || "Sem Equipe";
      
      if (filters.collab !== 'all' && colabName !== filters.collab) continue;
      if (filters.equipe !== 'all' && team !== filters.equipe) continue;

      if (filters.mes && filters.mes !== 'all') {
          var selectedMonth = parseInt(filters.mes, 10);
          if (dataRow.getMonth() !== selectedMonth || dataRow.getFullYear() !== now.getFullYear()) continue;
      }

      if (filters.periodo !== 'all') {
         if (filters.periodo === 'month' && (dataRow.getMonth() !== now.getMonth() || dataRow.getFullYear() !== now.getFullYear())) continue;
         
         if (filters.periodo === 'quarter') {
             var currentQuarter = Math.floor(now.getMonth() / 3);
             var rowQuarter = Math.floor(dataRow.getMonth() / 3);
             if (currentQuarter !== rowQuarter || dataRow.getFullYear() !== now.getFullYear()) continue;
         }
         if (filters.periodo === 'semester') {
             var currentSem = Math.floor(now.getMonth() / 6);
             var rowSem = Math.floor(dataRow.getMonth() / 6);
             if (currentSem !== rowSem || dataRow.getFullYear() !== now.getFullYear()) continue;
         }
         if (filters.periodo === 'year' && dataRow.getFullYear() !== now.getFullYear()) continue;
      }

      var sistema = dataAtend[i][2];
      var cat = dataAtend[i][3];
      var tempo = parseFloat(dataAtend[i][5]) || 0;
      var subcat = dataAtend[i][6]; // Pegando a subcategoria (Módulo)
      
      totalAtendimentos++;
      tempoTotal += tempo;
      
      if(cat) { categoriasCount[cat] = (categoriasCount[cat] || 0) + 1; }
      if(sistema) { sistemasCount[sistema] = (sistemasCount[sistema] || 0) + 1; }
      if(subcat) { subcategoriasCount[subcat] = (subcategoriasCount[subcat] || 0) + 1; } // Contando subcategorias
      if(colabName) { colabCount[colabName] = (colabCount[colabName] || 0) + 1; } // Contando acessos por colaborador
      
      if(dataRow.toDateString() === todayStr) { hojeCount++; }
      
      var rowDStr = dataRow.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
      if(evolucaoMapAtendimentos[rowDStr] !== undefined) {
          evolucaoMapAtendimentos[rowDStr]++;
          evolucaoMapTempo[rowDStr] += tempo;
      }
    }
    
    var tma = totalAtendimentos > 0 ? (tempoTotal / totalAtendimentos).toFixed(1) : 0;
    
    var topSistema = "Nenhum";
    var maxSys = 0;
    for(var s in sistemasCount) {
        if(sistemasCount[s] > maxSys) { maxSys = sistemasCount[s]; topSistema = s; }
    }

    // Identificando a top Subcategoria
    var topSubcategoria = "Nenhum";
    var maxSub = 0;
    for(var sub in subcategoriasCount) {
        if(subcategoriasCount[sub] > maxSub) { maxSub = subcategoriasCount[sub]; topSubcategoria = sub; }
    }

    // Gerando o Ranking Array
    var rankingColabs = [];
    for(var colab in colabCount) {
        rankingColabs.push({ nome: colab, acessos: colabCount[colab] });
    }
    // Ordenando decrescente
    rankingColabs.sort(function(a, b) { return b.acessos - a.acessos; });
    
    var dataEvolucaoAtend = last7Days.map(function(d) { return evolucaoMapAtendimentos[d]; });
    var dataEvolucaoTempo = last7Days.map(function(d) { return evolucaoMapTempo[d]; });

    return { 
      total: totalAtendimentos, 
      tma: tma, 
      hoje: hojeCount,
      topSistema: topSistema,
      topSubcategoria: topSubcategoria, // Enviando pro front
      rankingColabs: rankingColabs,     // Enviando pro front
      categorias: categoriasCount, 
      sistemas: sistemasCount,
      subcategorias: subcategoriasCount, // Nova devolução de dados pro Gráfico de Subcategorias
      labels7dias: last7Days,
      data7diasAtend: dataEvolucaoAtend,
      data7diasTempo: dataEvolucaoTempo
    };
  } catch (e) { 
    return { total: 0, tma: 0, hoje: 0, topSistema: "-", topSubcategoria: "-", rankingColabs: [], categorias: {}, sistemas: {}, subcategorias: {}, labels7dias: [], data7diasAtend: [], data7diasTempo: [] }; 
  }
}

function getCalendarEvents() {
  var events = [];
  
  function formatDateISO(dateObj) {
    if (!dateObj) return "";
    var d = new Date(dateObj);
    return d.getFullYear() + '-' + ('0' + (d.getMonth()+1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
  }

  var teamMap = {};
  try {
    var colabSheet = getSheetByKey("COLABORADORES_ONGOING");
    var colabData = colabSheet.getDataRange().getValues();
    for(var c=1; c<colabData.length; c++) {
      if(colabData[c][0]) teamMap[colabData[c][0]] = colabData[c][1]; 
    }
  } catch(e) {}

  try {
    var sheetRotinas = getSheetByKey("ROTINAS_PLANEJADAS");
    var dataRotinas = sheetRotinas.getDataRange().getValues();
    for (var i = 1; i < dataRotinas.length; i++) {
      if (dataRotinas[i][0]) {
        var horaStr = "00:00";
        if(dataRotinas[i][2] instanceof Date) {
           horaStr = ('0'+dataRotinas[i][2].getHours()).slice(-2) + ':' + ('0'+dataRotinas[i][2].getMinutes()).slice(-2);
        } else if(dataRotinas[i][2]) {
           horaStr = dataRotinas[i][2].toString();
        }
        
        var prioStr = dataRotinas[i][7] ? dataRotinas[i][7].toString() : "2 Normal";

        events.push({
          id: dataRotinas[i][6],
          dateIso: formatDateISO(dataRotinas[i][0]),
          title: dataRotinas[i][1],
          time: horaStr,
          status: dataRotinas[i][5] || "Pendente",
          type: "Rotina",
          collaborator: "Geral",
          team: "Geral", 
          duration: parseFloat(dataRotinas[i][4]) || 0,
          priority: prioStr
        });
      }
    }
  } catch (e) {}

  try {
    var sheetAtend = getSheetByKey("ATENDIMENTOS_REGISTRO");
    var dataAtend = sheetAtend.getDataRange().getValues();
    for (var j = 1; j < dataAtend.length; j++) {
      if (dataAtend[j][0]) {
        var colabName = dataAtend[j][1];
        events.push({
          id: null, 
          dateIso: formatDateISO(dataAtend[j][0]),
          title: dataAtend[j][1] + " (" + dataAtend[j][2] + ")",
          time: new Date(dataAtend[j][0]).toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'}),
          status: "Concluído",
          type: "Atendimento",
          collaborator: colabName,
          team: teamMap[colabName] || "Sem Equipe", 
          duration: parseFloat(dataAtend[j][5]) || 0,
          priority: "1 Máxima" 
        });
      }
    }
  } catch (e) {}

  return events;
}
