// 🟢 Servir HTML
function doGet() {
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('Gestão N2 - CS Operation')
    .setSandboxMode(HtmlService.SandboxMode.IFRAME)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function getSheetByKey(sheetName) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) throw new Error("Aba '" + sheetName + "' não encontrada.");
  return sheet;
}

// 👥 OBTER COLABORADORES
function getColaboradores() {
  try {
    var sheet = getSheetByKey("COLABORADORES_ONGOING");
    var data = sheet.getDataRange().getValues();
    var output = [];
    for (var i = 1; i < data.length; i++) {
      var nome = data[i][0];
      var statusRaw = data[i][3]; 
      var status = statusRaw ? statusRaw.toString().trim().toUpperCase() : "";
      if (nome && status === "ATIVO") {
        output.push({ nome: nome, equipe: data[i][1] });
      }
    }
    output.sort(function(a, b) { return a.nome.localeCompare(b.nome); });
    return output;
  } catch (e) { return []; }
}

// 📋 OBTER EQUIPES
function getEquipesList() {
  try {
    var sheet = getSheetByKey("COLABORADORES_ONGOING");
    var range = sheet.getRange("B2");
    var rule = range.getDataValidation();
    if (rule != null && rule.getCriteriaType() === SpreadsheetApp.DataValidationCriteria.VALUE_IN_LIST) {
      return rule.getCriteriaValues()[0];
    }
    return ["Bruna Santos", "Carina Andrade", "Edimarley Oliveira"];
