  }
}

// 💾 SALVAR E ATUALIZAR
function salvarNovoColaborador(form) {
  try {
    var sheet = getSheetByKey("COLABORADORES_ONGOING");
    sheet.appendRow([form.nome, form.equipe, new Date(), "Ativo"]);
    return { success: true, message: "Colaborador cadastrado! ✅" };
  } catch (e) { throw new Error(e.message); }
}

function salvarAtendimento(form) {
  try {
    var sheet = getSheetByKey("ATENDIMENTOS_REGISTRO");
    // 🌟 Subcategoria na última coluna preservando o dashboard
    sheet.appendRow([new Date(), form.solicitante, form.sistema, form.categoria, form.descricao, form.tempo, form.subcategoria || ""]);
