    </main>

    <script>
      let currentDate = new Date();
      let selectedDateObj = new Date(); 
      let calendarEventsCache = [];
      let holidays = ["01/01", "21/04", "01/05", "07/09", "12/10", "02/11", "15/11", "25/12"]; 

      const ITEMS_PER_PAGE = 5;
      let currentPageOpen = 1;
      let currentPageDone = 1;
      let currentEventsOpen = [];
      let currentEventsDone = [];

      let notifiedEvents = new Set();
      let audioCtx = null;

      const subcategoriasMap = {
        "KOMUNIC": [
          "Meus dados", "Integrações", "Pessoas e contatos", "Atendimentos", 
          "Histórico de atendimentos", "Usuários", "Cargos", "Organizações", 
          "Departamentos", "Mensagens padrões", "Robôs", "Assunto do chamado", 
          "Avaliações", "Respostas rápidas", "Horário de atendimento", "Feriados", 
          "Tags", "Importar dados"
        ],
        "ACESSÓRIAS": [
          "Usuários e permissões", "Departamentos", "Configurações gerais", 
          "e-Contínuo", "Aplicativo e Área VIP", "Comunicados", "Dados do meu perfil", 
          "Integrações", "Obrigações", "Feriados", "Grupos de obrigações", 
          "Regimes tributários", "Relatórios", "Empresas", "Importar cadastros", 
          "Lista de entregas", "Gestão de processos", "Solicitações", "Método APLA",
          "Painel de Indicadores"
        ],
        "AC DOC'S": [
          "Dashboard", "Configuração de matrizes", "Régua de cobrança", 
          "Vencimento", "Inativação de matriz"
        ],
        "OUTROS": ["Outros"]
      };

      function updateSubcategorias() {
        const sistema = document.getElementById('input-sistema').value;
        const subcatSelect = document.getElementById('input-subcategoria');
        const divSubcat = document.getElementById('div-subcategoria');

        subcatSelect.innerHTML = '<option value="" disabled selected>Selecione o módulo...</option>';

        if (subcategoriasMap[sistema]) {
          const itensUnicos = [...new Set(subcategoriasMap[sistema])];
          
          itensUnicos.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item;
            opt.textContent = item;
            subcatSelect.appendChild(opt);
          });
          divSubcat.classList.remove('hidden');
        } else {
          divSubcat.classList.add('hidden');
        }
      }

      // 🌟 [MELHORIA] Garantido que o Dashboard abra por padrão na inicialização
      window.onload = function() {
        showSection('dashboard'); // Força inicialização na tela de dashboard
        renderCalendar();
        loadColaboradores();
        loadEquipes();
        loadCalendarEvents();
        
        if ("Notification" in window && Notification.permission !== "granted" && Notification.permission !== "denied") {
          Notification.requestPermission();
        }
        setInterval(checkAlarms, 10000); 
      };

      document.addEventListener('click', () => {
        if(!audioCtx) {
           const AudioContext = window.AudioContext || window.webkitAudioContext;
           if(AudioContext) audioCtx = new AudioContext();
        }
        if(audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      }, { once: true });

      function playNotificationSound() {
        try {
          if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === 'suspended') audioCtx.resume();
          const osc = audioCtx.createOscillator();
          const gainNode = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(880, audioCtx.currentTime); 
          osc.frequency.exponentialRampToValueAtTime(440, audioCtx.currentTime + 0.3);
          gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
          gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
          osc.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.3);
        } catch(e) { console.log("Áudio não suportado ou bloqueado pelo navegador."); }
      }

      function checkAlarms() {
        if (!calendarEventsCache || calendarEventsCache.length === 0) return;
        
        let now = new Date();
        let todayIso = now.getFullYear() + '-' + ('0'+(now.getMonth()+1)).slice(-2) + '-' + ('0'+now.getDate()).slice(-2);
        let currentTimeStr = ('0'+now.getHours()).slice(-2) + ':' + ('0'+now.getMinutes()).slice(-2);

        calendarEventsCache.forEach(ev => {
          if (ev.status !== "Concluído" && ev.dateIso === todayIso && ev.time === currentTimeStr && ev.type === "Rotina") {
             if (!notifiedEvents.has(ev.id)) {
                 notifiedEvents.add(ev.id); 
                 playNotificationSound(); 
                 
                 if ("Notification" in window && Notification.permission === "granted") {
                     new Notification("🚨 Alerta de Rotina!", {
                         body: `Hora de realizar: "${ev.title}" (Programado para ${ev.time} - Prioridade: ${ev.priority})`,
                         icon: "https://fonts.gstatic.com/s/i/short-term/release/materialsymbolsoutlined/notifications_active/default/24px.svg"
                     });
                 } else {
                     showModal("🚨 Alerta de Rotina!", `A rotina "${ev.title}" está programada para agora (${ev.time})!`, 'alert');
                 }
             }
          }
        });
      }

      function showLoader() { document.getElementById('loader').classList.remove('hidden'); }
      function hideLoader() { document.getElementById('loader').classList.add('hidden'); }

      function showModal(title, message, type, confirmCallback) {
        document.getElementById('modal-title').innerText = title;
        document.getElementById('modal-message').innerText = message;
        
        const modalIcon = document.getElementById('modal-icon');
        const actions = document.getElementById('modal-actions');
        actions.innerHTML = '';
        
        if (type === 'confirm') {
          modalIcon.innerText = "help_outline";
          modalIcon.className = "material-symbols-outlined text-4xl text-[#C8A153]";
          
          const btnCancel = document.createElement('button');
          btnCancel.className = "px-6 py-2.5 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-bold transition";
          btnCancel.innerText = "Cancelar";
          btnCancel.onclick = () => document.getElementById('custom-modal').classList.add('hidden');
          
          const btnConfirm = document.createElement('button');
          btnConfirm.className = "px-6 py-2.5 text-white bg-[#0B2B5E] hover:bg-[#153975] rounded-xl text-sm font-bold transition shadow-lg shadow-[#0B2B5E]/30";
          btnConfirm.innerText = "Sim, Concluir";
          btnConfirm.onclick = () => {
            document.getElementById('custom-modal').classList.add('hidden');
            if(confirmCallback) confirmCallback();
          };
          
          actions.appendChild(btnCancel);
          actions.appendChild(btnConfirm);
        } else {
          modalIcon.innerText = title.includes('Erro') ? "error" : "check_circle";
          modalIcon.className = title.includes('Erro') ? "material-symbols-outlined text-4xl text-red-500" : (title.includes('Alerta') ? "material-symbols-outlined text-4xl text-[#C8A153]" : "material-symbols-outlined text-4xl text-emerald-500");

          const btnOk = document.createElement('button');
          btnOk.className = "px-8 py-2.5 text-white bg-[#0B2B5E] hover:bg-[#153975] rounded-xl text-sm font-bold transition shadow-lg shadow-[#0B2B5E]/30";
          btnOk.innerText = "OK";
          btnOk.onclick = () => document.getElementById('custom-modal').classList.add('hidden');
          actions.appendChild(btnOk);
        }
        
        document.getElementById('custom-modal').classList.remove('hidden');
      }

      function openRotinaModal() {
        const dateInput = document.getElementById('input-data-rotina');
        if(dateInput && selectedDateObj) {
          dateInput.value = selectedDateObj.getFullYear() + '-' + ('0'+(selectedDateObj.getMonth()+1)).slice(-2) + '-' + ('0'+selectedDateObj.getDate()).slice(-2);
        }
        document.getElementById('rotina-modal').classList.remove('hidden');
      }

      function closeRotinaModal() {
        document.getElementById('rotina-modal').classList.add('hidden');
        document.getElementById('form-rotina').reset();
        document.getElementById('div-data-fim-modal').style.display = 'none';
      }

      function showSection(id) {
        ['dashboard','atendimentos','rotinas','colaborador'].forEach(s => {
          document.getElementById(s).classList.add('hidden');
          document.getElementById('nav-'+s).classList.remove('active');
        });
        document.getElementById(id).classList.remove('hidden');
        document.getElementById('nav-'+id).classList.add('active');
        if(id === 'rotinas') renderCalendar();
        if(id === 'dashboard') loadDashboard();
      }

      function loadColaboradores() { 
        google.script.run.withSuccessHandler(d => { 
          const s = document.getElementById('input-solicitante'); 
          const f = document.getElementById('filter-collab'); 
          const dashF = document.getElementById('dash-filter-collab'); 
          
          if(s){s.innerHTML='<option value="">Selecione...</option>'; d.forEach(c=>s.add(new Option(c.nome,c.nome)));}
          if(f){f.innerHTML='<option value="all">👥 T. Colab</option>'; d.forEach(c=>f.add(new Option(c.nome,c.nome)));}
          if(dashF){dashF.innerHTML='<option value="all">👥 T. Colab</option>'; d.forEach(c=>dashF.add(new Option(c.nome,c.nome)));}
        }).getColaboradores(); 
      }
      
      function loadEquipes() { 
        google.script.run.withSuccessHandler(l => { 
          const s = document.getElementById('input-equipe'); 
          const fEq = document.getElementById('filter-equipe'); 
          const dashEq = document.getElementById('dash-filter-equipe'); 
          
          if(s){s.innerHTML=''; l.forEach(i=>s.add(new Option(i,i)));} 
          if(fEq){fEq.innerHTML='<option value="all">🏢 T. Equipes</option>'; l.forEach(i=>fEq.add(new Option(i,i)));}
          if(dashEq){dashEq.innerHTML='<option value="all">🏢 T. Equipes</option>'; l.forEach(i=>dashEq.add(new Option(i,i)));}
        }).getEquipesList(); 
      }

      function loadDashboard() { 
        showLoader(); 

        const dashFilters = {
           periodo: document.getElementById('dash-filter-period') ? document.getElementById('dash-filter-period').value : 'all',
           mes: document.getElementById('dash-filter-month') ? document.getElementById('dash-filter-month').value : 'all',
           equipe: document.getElementById('dash-filter-equipe') ? document.getElementById('dash-filter-equipe').value : 'all',
           collab: document.getElementById('dash-filter-collab') ? document.getElementById('dash-filter-collab').value : 'all'
        };

        google.script.run.withSuccessHandler(d => {
          hideLoader();
          
          document.getElementById('kpi-total').innerText = d.total; 
          document.getElementById('kpi-tma').innerText = d.tma;
          document.getElementById('kpi-hoje').innerText = d.hoje;
          document.getElementById('kpi-top-sys').innerText = d.topSistema;

          ['chart-sistemas', 'chart-evolucao', 'chart-categorias'].forEach(id => {
            const canvas = document.getElementById(id);
            if(canvas) {
              const existingChart = Chart.getChart(canvas);
              if(existingChart) existingChart.destroy();
            }
          });

          const ctxSistemas = document.getElementById('chart-sistemas');
          if (ctxSistemas && Object.keys(d.sistemas).length > 0) {
            const sysValues = Object.values(d.sistemas);
            const totalSys = sysValues.reduce((a, b) => a + b, 0);
            const maxVal = Math.max(...sysValues);
            const pct = totalSys > 0 ? Math.round((maxVal / totalSys) * 100) : 0;
            document.getElementById('gauge-center-text').innerText = pct + '%';

            new Chart(ctxSistemas, {
              type: 'doughnut',
              data: {
                labels: Object.keys(d.sistemas),
                datasets: [{
                  data: sysValues,
                  backgroundColor: ['#0B2B5E', '#C8A153', '#1e3a8a', '#eab308', '#cbd5e1'], 
                  borderWidth: 0,
                  hoverOffset: 6
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                circumference: 180, 
                rotation: -90,      
                cutout: '80%',      
                plugins: { legend: { display: false } } 
              }
            });
          }

          const ctxEvolucao = document.getElementById('chart-evolucao');
          if (ctxEvolucao) {
            new Chart(ctxEvolucao, {
              type: 'line',
              data: {
                labels: d.labels7dias,
                datasets: [
                  {
                    label: 'Volume de Chamados',
                    data: d.data7diasAtend,
                    borderColor: '#0B2B5E', 
                    backgroundColor: 'rgba(11, 43, 94, 0.1)',
                    borderWidth: 3,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#0B2B5E',
                    pointRadius: 4,
                    tension: 0.4, 
                    yAxisID: 'y'
                  },
                  {
                    label: 'Tempo Total (min)',
                    data: d.data7diasTempo,
                    borderColor: '#C8A153', 
                    borderWidth: 2,
                    borderDash: [5, 5], 
                    pointRadius: 0,
                    tension: 0.4,
                    yAxisID: 'y1'
                  }
                ]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 10, font: {family: 'Poppins'} } } },
                scales: {
                  x: { grid: { display: false }, ticks: {font: {family: 'Poppins', size: 11}} },
                  y: { type: 'linear', display: true, position: 'left', grid: { borderDash: [4, 4], color: '#e2e8f0' }, ticks: {font: {family: 'Poppins', size: 11}} },
                  y1: { type: 'linear', display: true, position: 'right', grid: { display: false }, ticks: {font: {family: 'Poppins', size: 11}} }
                }
              }
            });
          }

          const ctxCategorias = document.getElementById('chart-categorias');
          if (ctxCategorias) {
            new Chart(ctxCategorias, {
              type: 'bar',
              data: {
                labels: Object.keys(d.categorias),
                datasets: [{
                  label: 'Chamados',
                  data: Object.values(d.categorias),
                  backgroundColor: '#0B2B5E', 
                  borderRadius: 6, 
                  barThickness: 40
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                  x: { grid: { display: false }, ticks: {font: {family: 'Poppins', size: 12, weight: '500'}} },
                  y: { beginAtZero: true, grid: { borderDash: [4, 4], color: '#e2e8f0' }, ticks: {font: {family: 'Poppins', size: 11}} }
                }
              }
            });
          }

        }).getDashboardData(dashFilters); 
      }

      function loadCalendarEvents() { 
        google.script.run.withSuccessHandler(e => { 
          calendarEventsCache = e; 
          renderCalendar(); 
          selectDay(selectedDateObj); 
        }).getCalendarEvents(); 
      }

      function handleAtendimento(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          showModal("Sucesso", r.message, 'alert');
          document.getElementById('form-atendimento').reset(); 
          
          document.getElementById('div-subcategoria').classList.add('hidden');
          
          loadCalendarEvents();
        }).salvarAtendimento({
          solicitante: document.getElementById('input-solicitante').value, 
          sistema: e.target.sistema.value, 
          subcategoria: e.target.subcategoria ? e.target.subcategoria.value : "", 
          categoria: e.target.categoria.value, 
          tempo: e.target.tempo.value, 
          descricao: e.target.descricao.value
        }); 
      }
      
      function handleRotina(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          closeRotinaModal(); 
          if(r.success){
            showModal("Sucesso", r.message, 'alert'); 
          } else {
            showModal("Aviso", r.message, 'alert'); 
          }
          loadCalendarEvents();
        }).salvarRotina({
          titulo: e.target.titulo.value, 
          dataRotina: e.target.dataRotina.value, 
          horaInicio: e.target.horaInicio.value,
          recorrencia: e.target.recorrencia.value,
          dataFim: e.target.dataFim.value,
          prioridade: e.target.prioridade.value 
        }); 
      }
      
      function handleColaborador(e) { 
        e.preventDefault(); 
        showLoader();
        google.script.run.withSuccessHandler(r=>{
          hideLoader();
          showModal("Sucesso", r.message, 'alert');
          document.getElementById('form-colaborador').reset(); 
          loadColaboradores();
        }).salvarNovoColaborador({nome:e.target.nome.value, equipe:e.target.equipe.value}); 
      }

      function markAsDone(id) {
        showModal('Confirmação', 'Você finalizou esta rotina?', 'confirm', function() {
          showLoader();
          google.script.run.withSuccessHandler(function(res) {
            hideLoader();
            if(res.success) {
              loadCalendarEvents(); 
            } else {
              showModal('Erro', "Falha: " + res.message, 'alert');
            }
          }).concluirRotina(id);
        });
      }

      function changeMonth(step) {
        const period = document.getElementById('filter-period').value;
        let jump = 1;
        if(period === 'quarter') jump = 3;
        if(period === 'semester') jump = 6;
        if(period === 'year') jump = 12;
        currentDate.setMonth(currentDate.getMonth() + (step * jump));
        renderCalendar();
      }

      function renderCalendar() {
        const wrapper = document.getElementById('calendar-wrapper');
        const period = document.getElementById('filter-period').value;
        const filterCollab = document.getElementById('filter-collab').value;
        const filterEquipe = document.getElementById('filter-equipe').value; 
        
        if(!wrapper) return;
        wrapper.innerHTML = ''; 

        let monthsToShow = 1;
        if(period === 'quarter') monthsToShow = 3;
        if(period === 'semester') monthsToShow = 6;
        if(period === 'year') monthsToShow = 12;

        let renderDate = new Date(currentDate); 
        const today = new Date(); today.setHours(0,0,0,0);
        
        let totalMinutesGasto = 0;

        const eventosFiltrados = calendarEventsCache.filter(ev => {
          let passCollab = (filterCollab === 'all' || ev.collaborator === filterCollab);
          let passEquipe = (filterEquipe === 'all' || ev.team === filterEquipe || ev.team === "Geral"); 
          return passCollab && passEquipe;
        });

        const eventosPorData = {};
        eventosFiltrados.forEach(ev => {
          if (!eventosPorData[ev.dateIso]) eventosPorData[ev.dateIso] = [];
          eventosPorData[ev.dateIso].push(ev);
        });

        for (let m = 0; m < monthsToShow; m++) {
           let year = renderDate.getFullYear();
           let month = renderDate.getMonth();
           
           let monthContainer = document.createElement('div');
           monthContainer.className = "mb-8";
           let monthTitle = document.createElement('h3');
           monthTitle.className = "text-xl font-extrabold text-[#0B2B5E] mb-3 capitalize border-b-2 border-gray-200 pb-2";
           monthTitle.innerText = renderDate.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
           monthContainer.appendChild(monthTitle);

           let weekHeader = document.createElement('div');
           weekHeader.className = "week-header";
           ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'].forEach(d => {
             let span = document.createElement('span'); span.innerText = d; weekHeader.appendChild(span);
           });
           monthContainer.appendChild(weekHeader);

           let grid = document.createElement('div');
           grid.className = "month-grid";
           
           let firstDay = new Date(year, month, 1);
           let lastDay = new Date(year, month + 1, 0);

           for(let i=0; i<firstDay.getDay(); i++) { let empty = document.createElement('div'); grid.appendChild(empty); }

           for(let i=1; i<=lastDay.getDate(); i++) {
             let dayDate = new Date(year, month, i);
             let dayStr = ('0'+i).slice(-2)+'/'+('0'+(month+1)).slice(-2);
             let dataKey = year + '-' + ('0'+(month+1)).slice(-2) + '-' + ('0'+i).slice(-2); 

             let cell = document.createElement('div');
             cell.className = "cal-cell relative";
             
             if (selectedDateObj.getDate() === i && selectedDateObj.getMonth() === month && selectedDateObj.getFullYear() === year) {
               cell.style.boxShadow = "0 0 0 3px #C8A153";
               cell.style.transform = "scale(1.03)";
             }

             cell.onclick = () => { selectDay(dayDate); renderCalendar(); }; 

             let isHoliday = holidays.includes(dayStr);
             let isToday = dayDate.getTime() === today.getTime();
             let isWeekend = (dayDate.getDay()===0 || dayDate.getDay()===6);
             let isFuture = dayDate > today;
             
             let isPast = dayDate.getTime() < today.getTime();

             let events = eventosPorData[dataKey] || [];
             let hasOpen = events.some(e => e.status !== "Concluído");
             let hasDone = events.some(e => e.status === "Concluído");
             
             let isPastPending = isPast && hasOpen; 

             if (isPastPending) {
               cell.style.border = "2px solid #ef4444"; 
               cell.style.backgroundColor = "#fff0f2"; 
               cell.style.color = "#be123c"; 
               cell.innerHTML = `<b class="flex justify-between items-center">${i} <span class="text-red-600 text-lg leading-none font-black animate-pulse" title="Pendência Atrasada!">!</span></b>`; 
             }
             else if(isHoliday) { cell.style.border = "2px solid #C8A153"; cell.style.backgroundColor = "#fffbf0"; cell.style.color = "#927129"; cell.innerHTML = `<b>${i} ★</b>`; } 
             else if(isToday) { cell.style.backgroundColor = "#0B2B5E"; cell.style.color = "white"; cell.innerHTML = `<b>${i}</b>`; } 
             else if(isWeekend) { cell.style.backgroundColor = "#f9fafb"; cell.style.color = "#9ca3af"; cell.style.pointerEvents = "none"; cell.innerHTML = `<b>${i}</b>`; } 
             else if(isFuture) { cell.style.backgroundColor = "#eef2ff"; cell.style.color = "#0B2B5E"; cell.style.fontWeight = "600"; cell.innerHTML = `<b>${i}</b>`; } 
             else { cell.style.color = "#475569"; cell.innerHTML = `<b class="font-medium">${i}</b>`; }

             if(events.length > 0) {
               let totalDay = events.length;
               let doneDay = events.filter(e => e.status === "Concluído").length;
               
               events.forEach(ev => {
                 if(ev.status === "Concluído" && ev.duration) {
                   totalMinutesGasto += ev.duration;
                 }
               });

               let footerContainer = document.createElement('div');
               footerContainer.className = "flex justify-between items-end mt-auto";

               let dots = document.createElement('div'); 
               dots.className = "flex gap-1 flex-wrap";
               if(hasDone) dots.innerHTML += `<div class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm"></div>`;
               if(hasOpen) dots.innerHTML += `<div class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-sm"></div>`;
               
               let fraction = document.createElement('span');
               fraction.className = "text-[10px] font-bold text-gray-500 bg-gray-100 px-1.5 rounded-md";
               fraction.innerText = `${doneDay}/${totalDay}`;

               footerContainer.appendChild(dots);
               footerContainer.appendChild(fraction);
               cell.appendChild(footerContainer);
             }
             grid.appendChild(cell);
           }
           monthContainer.appendChild(grid);
           wrapper.appendChild(monthContainer);
           renderDate.setMonth(renderDate.getMonth() + 1);
        }
        
        const timeDisplay = document.getElementById('total-time-display');
        if(timeDisplay) {
          let hours = Math.floor(totalMinutesGasto / 60);
          let mins = Math.floor(totalMinutesGasto % 60);
          timeDisplay.innerText = `${hours}h ${mins}m`;
        }

        selectDay(selectedDateObj, true);
      }

      function selectDay(dateObj, isReRender = false) {
        if(!isReRender) {
           selectedDateObj = dateObj; 
        }
        
        document.getElementById('selected-date-display').innerText = dateObj.toLocaleDateString('pt-BR',{weekday:'long', day:'numeric', month:'long'});
        
        const filterCollab = document.getElementById('filter-collab').value;
        const filterEquipe = document.getElementById('filter-equipe').value; 
        
        let dateIsoTarget = dateObj.getFullYear() + '-' + ('0'+(dateObj.getMonth()+1)).slice(-2) + '-' + ('0'+dateObj.getDate()).slice(-2);

        let events = calendarEventsCache.filter(ev => {
           let passCollab = (filterCollab === 'all' || ev.collaborator === filterCollab);
           let passEquipe = (filterEquipe === 'all' || ev.team === filterEquipe || ev.team === "Geral");
           return ev.dateIso === dateIsoTarget && passCollab && passEquipe;
        });

        events.sort((a, b) => a.priority.localeCompare(b.priority));

        currentEventsDone = events.filter(e => e.status === "Concluído");
        currentEventsOpen = events.filter(e => e.status !== "Concluído");

        if(!isReRender) {
          currentPageOpen = 1;
          currentPageDone = 1;
        }

        renderOpenList();
        renderDoneList();
      }

      function changePageOpen(step) { currentPageOpen += step; renderOpenList(); }
      function changePageDone(step) { currentPageDone += step; renderDoneList(); }

      function renderOpenList() {
        const listOpen = document.getElementById('list-open');
        listOpen.innerHTML = '';

        if(currentEventsOpen.length === 0) {
          listOpen.innerHTML = '<p class="text-sm text-gray-400 font-medium italic">Nenhuma pendência.</p>';
          return;
        }

        let start = (currentPageOpen - 1) * ITEMS_PER_PAGE;
        let end = start + ITEMS_PER_PAGE;
        let paginated = currentEventsOpen.slice(start, end);

        let wrapper = document.createElement('div');
        wrapper.className = "space-y-3 mb-2";

        paginated.forEach(ev => {
          let prioColor = "bg-blue-100 text-blue-700 border-blue-200";
          if(ev.priority.includes("1")) prioColor = "bg-rose-100 text-rose-700 border-rose-200";
          else if(ev.priority.includes("3")) prioColor = "bg-emerald-100 text-emerald-700 border-emerald-200";
          let prioridadeTag = `<span class="${prioColor} border text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">${ev.priority}</span>`;

          let html = `
            <div class="bg-white border-l-4 border-rose-500 p-4 rounded-xl shadow-md flex justify-between items-center group">
              <div class="flex-1">
                <p class="font-bold text-[#0B2B5E] text-sm">${ev.title}</p>
                <div class="flex justify-between text-xs text-gray-500 mt-2 items-center">
                   <div class="flex gap-2 items-center font-medium">
                     <span class="bg-gray-100 py-1 px-2 rounded-md flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">schedule</span> ${ev.time}</span> 
                     <span class="bg-gray-100 py-1 px-2 rounded-md hidden md:inline-flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">group</span> ${ev.team}</span>
                   </div>
                   ${prioridadeTag}
                </div>
              </div>
              ${ev.id ? `<button onclick="markAsDone('${ev.id}')" class="ml-4 bg-emerald-50 hover:bg-emerald-500 hover:text-white text-emerald-600 p-2.5 rounded-full transition shadow-sm border border-emerald-200 hover:border-emerald-500" title="Concluir tarefa">
                <span class="material-symbols-outlined text-md font-bold">check</span>
              </button>` : ''}
            </div>`;
           wrapper.innerHTML += html;
        });

        listOpen.appendChild(wrapper);

        if (currentEventsOpen.length > ITEMS_PER_PAGE) {
           let totalPages = Math.ceil(currentEventsOpen.length / ITEMS_PER_PAGE);
           let pagHTML = `
             <div class="flex justify-between items-center mt-auto pt-4 border-t border-gray-200">
                <button onclick="changePageOpen(-1)" class="text-xs font-bold text-rose-600 hover:underline disabled:opacity-30 uppercase tracking-widest" ${currentPageOpen===1?'disabled':''}>◀ Ant</button>
                <span class="text-xs text-gray-500 font-bold bg-white px-3 py-1 rounded-full border border-gray-200 shadow-sm">${currentPageOpen} / ${totalPages}</span>
                <button onclick="changePageOpen(1)" class="text-xs font-bold text-rose-600 hover:underline disabled:opacity-30 uppercase tracking-widest" ${currentPageOpen===totalPages?'disabled':''}>Próx ▶</button>
             </div>`;
           listOpen.innerHTML += pagHTML;
        }
      }

      function renderDoneList() {
        const listDone = document.getElementById('list-done');
        listDone.innerHTML = '';

        if(currentEventsDone.length === 0) {
          listDone.innerHTML = '<p class="text-sm text-gray-400 font-medium italic">Nenhum registro concluído.</p>';
          return;
        }

        let start = (currentPageDone - 1) * ITEMS_PER_PAGE;
        let end = start + ITEMS_PER_PAGE;
        let paginated = currentEventsDone.slice(start, end);

        let wrapper = document.createElement('div');
        wrapper.className = "space-y-3 mb-2";

        paginated.forEach(ev => {
           let prioColor = "bg-gray-100 text-gray-500 border-gray-200";
           if(ev.priority.includes("1")) prioColor = "bg-rose-50 text-rose-400 border-rose-100";
           else if(ev.priority.includes("3")) prioColor = "bg-emerald-50 text-emerald-500 border-emerald-100";
           let prioridadeTag = `<span class="${prioColor} border text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider">${ev.priority}</span>`;

           let html = `
            <div class="bg-gray-50/80 border border-gray-200 p-4 rounded-xl shadow-sm opacity-80">
              <p class="font-bold text-gray-500 text-sm line-through decoration-2 decoration-emerald-400">${ev.title}</p>
              <div class="flex justify-between text-xs text-gray-400 mt-2 items-center">
                 <div class="flex gap-2 items-center font-medium">
                   <span class="bg-white py-1 px-2 rounded-md border border-gray-100 flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">schedule</span> ${ev.time}</span>
                   <span class="bg-white py-1 px-2 rounded-md border border-gray-100 hidden md:inline-flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">person</span> ${ev.collaborator}</span>
                 </div>
                 ${prioridadeTag}
              </div>
            </div>`;
           wrapper.innerHTML += html;
        });

        listDone.appendChild(wrapper);

        if (currentEventsDone.length > ITEMS_PER_PAGE) {
           let totalPages = Math.ceil(currentEventsDone.length / ITEMS_PER_PAGE);
           let pagHTML = `
             <div class="flex justify-between items-center mt-auto pt-4 border-t border-gray-200">
                <button onclick="changePageDone(-1)" class="text-xs font-bold text-emerald-600 hover:underline disabled:opacity-30 uppercase tracking-widest" ${currentPageDone===1?'disabled':''}>◀ Ant</button>
                <span class="text-xs text-gray-500 font-bold bg-white px-3 py-1 rounded-full border border-gray-200 shadow-sm">${currentPageDone} / ${totalPages}</span>
                <button onclick="changePageDone(1)" class="text-xs font-bold text-emerald-600 hover:underline disabled:opacity-30 uppercase tracking-widest" ${currentPageDone===totalPages?'disabled':''}>Próx ▶</button>
             </div>`;
           listDone.innerHTML += pagHTML;
        }
      }
    </script>
  </body>
</html>
