<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      body { font-family: 'Poppins', sans-serif; background-color: #f0f2f5; }
      
      .cal-cell {
        min-height: 80px;
        padding: 6px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        cursor: pointer;
        background-color: white;
        transition: all 0.2s ease;
      }
      .cal-cell:hover { z-index: 10; transform: translateY(-2px) scale(1.02); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
      .week-header { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; text-align: center; font-size: 0.75rem; font-weight: 700; color: #9ca3af; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .month-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; margin-bottom: 2rem; }
      
      .nav-item { 
        transition: all 0.3s ease; 
        border-left: 4px solid transparent; 
        color: #cbd5e1;
      }
      .nav-item:hover:not(.active) { 
        background-color: rgba(255, 255, 255, 0.05); 
        color: white; 
      }
      .nav-item.active { 
        background-color: #f0f2f5; 
        color: #0B2B5E !important; 
        font-weight: 600; 
        border-left: 4px solid #C8A153; 
        border-radius: 0 24px 24px 0; 
        margin-right: 16px;
        box-shadow: -5px 0px 15px rgba(0,0,0,0.05);
      }
      .nav-item.active .material-symbols-outlined { color: #C8A153; }
      
      .fade-in { animation: fadeIn 0.4s ease-out; }
      @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
      
      @keyframes spin-slow { 100% { transform: rotate(360deg); } }
      .animate-spin-slow { animation: spin-slow 2.5s linear infinite; }

      input, select, textarea { transition: all 0.2s; }
      input:focus, select:focus, textarea:focus { border-color: #C8A153 !important; box-shadow: 0 0 0 3px rgba(200, 161, 83, 0.2) !important; outline: none; }
    </style>
  </head>
  <body class="h-screen flex overflow-hidden">

    <div id="custom-modal" class="hidden fixed inset-0 bg-[#0B2B5E]/60 z-[100] flex items-center justify-center fade-in backdrop-blur-sm">
      <div class="bg-white rounded-2xl shadow-2xl w-96 p-8 transform transition-all">
        <div class="flex items-center gap-3 mb-4" id="modal-header-container">
           <span id="modal-icon" class="material-symbols-outlined text-4xl">info</span>
           <h3 id="modal-title" class="text-xl font-bold text-[#0B2B5E]">Aviso</h3>
        </div>
        <p id="modal-message" class="text-gray-600 mb-8 text-sm leading-relaxed"></p>
        <div id="modal-actions" class="flex justify-end gap-3">
        </div>
      </div>
    </div>

    <div id="rotina-modal" class="hidden fixed inset-0 bg-[#0B2B5E]/60 z-[100] flex items-center justify-center fade-in backdrop-blur-sm">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 transform transition-all">
        <div class="flex items-center justify-between mb-6 border-b pb-4">
           <h3 class="text-xl font-bold text-[#0B2B5E] flex items-center gap-2">
             <span class="material-symbols-outlined text-[#C8A153]">event_note</span> Nova Rotina
           </h3>
           <button onclick="closeRotinaModal()" class="text-gray-400 hover:text-red-500 transition">
             <span class="material-symbols-outlined">close</span>
           </button>
        </div>
        <form id="form-rotina" onsubmit="handleRotina(event)" class="flex flex-col gap-5">
           <div>
             <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Título da Rotina</label>
             <input type="text" name="titulo" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm" placeholder="Ex: Reunião de Alinhamento" required>
           </div>
           <div class="grid grid-cols-2 gap-5">
             <div>
               <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Data</label>
               <input type="date" name="dataRotina" id="input-data-rotina" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700" required>
             </div>
             <div>
               <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Início</label>
               <input type="time" name="horaInicio" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700" required>
             </div>
           </div>
           
           <div class="grid grid-cols-2 gap-5">
             <div>
                <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Prioridade</label>
                <select name="prioridade" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700">
                  <option value="1 Máxima">🔴 1 Máxima</option>
                  <option value="2 Normal" selected>🔵 2 Normal</option>
                  <option value="3 Secundária">🟢 3 Secundária</option>
                </select>
             </div>
             <div>
                <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Repetição</label>
                <select name="recorrencia" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700" onchange="document.getElementById('div-data-fim-modal').style.display = this.value === 'none' ? 'none' : 'block'">
                  <option value="none">Não Repete</option>
                  <option value="daily">Diária</option>
                  <option value="weekly">Semanal</option>
                  <option value="monthly">Mensal</option>
                </select>
             </div>
           </div>
           
           <div id="div-data-fim-modal" style="display: none;">
              <label class="block text-xs font-bold text-gray-500 mb-1.5 uppercase tracking-wide">Até Quando?</label>
              <input type="date" name="dataFim" class="w-full p-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-700">
           </div>
           
           <div class="flex justify-end gap-3 mt-4 pt-6 border-t">
             <button type="button" onclick="closeRotinaModal()" class="px-5 py-2.5 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl text-sm font-bold transition">Cancelar</button>
             <button type="submit" class="px-5 py-2.5 text-white bg-[#C8A153] hover:bg-[#b58f43] rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-lg shadow-[#C8A153]/30">
               <span class="material-symbols-outlined text-sm">save</span> Salvar Rotina
             </button>
           </div>
        </form>
      </div>
    </div>

    <div id="loader" class="hidden absolute inset-0 bg-[#f0f2f5]/80 z-50 flex items-center justify-center flex-col backdrop-blur-md">
      <span class="material-symbols-outlined text-[#C8A153] animate-spin-slow" style="font-size: 64px;">hourglass_empty</span>
      <p class="text-[#0B2B5E] font-bold mt-4 tracking-widest uppercase text-sm">Processando...</p>
    </div>

    <aside class="w-72 bg-[#0B2B5E] shadow-2xl flex flex-col justify-between z-10 hidden md:flex text-white">
      <div>
        <div class="h-32 flex flex-col items-center justify-center border-b border-white/10 pt-4 pb-2">
          <div class="w-14 h-14 rounded-full flex items-center justify-center shadow-lg mb-3 overflow-hidden border-2 border-[#C8A153] bg-white">
            <img src="https://i.imgur.com/dgk9WN6.png" alt="Logo Gestão" class="w-full h-full object-cover">
          </div>
          <h1 class="text-md font-bold text-white tracking-widest uppercase text-center">Gestão N2 <span class="text-[#C8A153]">CS</span></h1>
        </div>

        <nav class="mt-8 space-y-2">
          <button onclick="showSection('dashboard')" id="nav-dashboard" class="nav-item flex items-center px-8 py-3.5 w-full text-left">
            <span class="material-symbols-outlined mr-4 text-xl">analytics</span> 
            <span class="font-medium text-sm">Dashboard Analítico</span>
          </button>
          
          <button onclick="showSection('atendimentos')" id="nav-atendimentos" class="nav-item flex items-center px-8 py-3.5 w-full text-left">
            <span class="material-symbols-outlined mr-4 text-xl">support_agent</span> 
            <span class="font-medium text-sm">Registro de Atend.</span>
          </button>
          
          <button onclick="showSection('rotinas')" id="nav-rotinas" class="nav-item flex items-center px-8 py-3.5 w-full text-left">
            <span class="material-symbols-outlined mr-4 text-xl">calendar_month</span> 
            <span class="font-medium text-sm">Rotinas e Calendário</span>
          </button>
          
          <button onclick="showSection('colaborador')" id="nav-colaborador" class="nav-item flex items-center px-8 py-3.5 w-full text-left">
            <span class="material-symbols-outlined mr-4 text-xl">person_add</span> 
            <span class="font-medium text-sm">Novo Colaborador</span>
          </button>
        </nav>
      </div>

      <div class="p-6 border-t border-white/10 space-y-4 mt-auto">
        
        <div>
           <p class="text-[10px] text-[#C8A153] font-bold uppercase tracking-wider mb-2">Acessos Rápidos</p>
           <div class="grid grid-cols-2 gap-2">
             <a href="https://app.acessorias.com/" target="_blank" class="flex items-center justify-center bg-white/5 hover:bg-[#C8A153] text-white text-[10px] font-bold py-2 rounded-lg transition border border-white/10 hover:border-[#C8A153]">ACESSÓRIAS</a>
             <a href="https://app.komunic.net/" target="_blank" class="flex items-center justify-center bg-white/5 hover:bg-[#C8A153] text-white text-[10px] font-bold py-2 rounded-lg transition border border-white/10 hover:border-[#C8A153]">KOMUNIC</a>
             <a href="https://acessorias.desk.blip.ai/chat" target="_blank" class="flex items-center justify-center bg-white/5 hover:bg-[#C8A153] text-white text-[10px] font-bold py-2 rounded-lg transition border border-white/10 hover:border-[#C8A153]">BLIP</a>
             <a href="https://acessorias.sensedata.io/customer_task_redirect_view" target="_blank" class="flex items-center justify-center bg-white/5 hover:bg-[#C8A153] text-white text-[10px] font-bold py-2 rounded-lg transition border border-white/10 hover:border-[#C8A153]">SENSE DATA</a>
           </div>
        </div>

        <div class="bg-white/5 rounded-xl p-5 border border-white/5">
          <p class="text-[10px] text-[#C8A153] font-bold uppercase tracking-wider mb-1">Status Operacional</p>
          <div class="flex items-end mt-1">
            <span class="text-3xl font-extrabold text-white leading-none" id="sla-display">--%</span>
            <span class="text-xs text-gray-400 mb-1 ml-2">Meta: 90%</span>
          </div>
          <div class="w-full bg-[#0B2B5E] border border-white/10 h-2 rounded-full mt-3 overflow-hidden">
            <div class="bg-[#C8A153] h-full rounded-full" style="width: 90%"></div>
          </div>
        </div>
      </div>
    </aside>

    <main class="flex-1 overflow-y-auto p-10 relative">

      <section id="dashboard" class="hidden fade-in space-y-8">
        
        <div class="flex justify-between items-end mb-2">
          <div>
            <h2 class="text-4xl font-extrabold text-[#0B2B5E] flex items-center gap-3">
              <span class="material-symbols-outlined text-[40px] text-[#C8A153]">donut_small</span> Visão Geral
            </h2>
          </div>
          <div class="text-right hidden sm:block">
            <h3 class="text-xl font-bold text-[#0B2B5E]">Conquistando a excelência:</h3>
            <p class="text-sm text-gray-500 font-medium">superando os desafios da sua Operação</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4 bg-white p-5 rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 items-center justify-between">
          <div class="flex items-center gap-2 text-sm font-bold text-[#0B2B5E] uppercase tracking-wide">
            <span class="material-symbols-outlined text-[#C8A153] text-xl">tune</span> Filtrar Dados
          </div>
          <div class="flex flex-wrap gap-4">
            
            <div class="relative flex items-center group gap-1">
              <select id="dash-filter-month" onchange="loadDashboard()" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-700 font-semibold cursor-pointer focus:border-[#C8A153] focus:ring-[#C8A153]">
                <option value="all">🗓️ Todos os Meses</option>
                <option value="0">📅 Janeiro</option>
                <option value="1">📅 Fevereiro</option>
                <option value="2">📅 Março</option>
                <option value="3">📅 Abril</option>
                <option value="4">📅 Maio</option>
                <option value="5">📅 Junho</option>
                <option value="6">📅 Julho</option>
                <option value="7">📅 Agosto</option>
                <option value="8">📅 Setembro</option>
                <option value="9">📅 Outubro</option>
                <option value="10">📅 Novembro</option>
                <option value="11">📅 Dezembro</option>
              </select>
              <span class="material-symbols-outlined text-[#C8A153] cursor-help text-lg opacity-60 hover:opacity-100 transition">info</span>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max px-3 py-1.5 bg-[#0B2B5E] text-white text-xs rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">Filtra os dados e gráficos do Dashboard pelo mês selecionado.</div>
            </div>

            <div class="relative flex items-center group gap-1">
              <select id="dash-filter-period" onchange="loadDashboard()" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-700 font-semibold cursor-pointer focus:border-[#C8A153] focus:ring-[#C8A153]">
                <option value="all">⏳ Todo o Período</option>
                <option value="month">📍 Este Mês Atual</option>
                <option value="quarter">📊 Este Trimestre</option>
                <option value="semester">📈 Este Semestre</option>
                <option value="year">📆 Este Ano</option>
              </select>
              <span class="material-symbols-outlined text-[#C8A153] cursor-help text-lg opacity-60 hover:opacity-100 transition">info</span>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max px-3 py-1.5 bg-[#0B2B5E] text-white text-xs rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">Filtra a visualização por blocos de tempo maiores.</div>
            </div>
            
            <div class="relative flex items-center group gap-1">
              <select id="dash-filter-equipe" onchange="loadDashboard()" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-700 font-semibold w-44 cursor-pointer focus:border-[#C8A153] focus:ring-[#C8A153]">
                <option value="all">🏢 Todas Equipes</option>
              </select>
              <span class="material-symbols-outlined text-[#C8A153] cursor-help text-lg opacity-60 hover:opacity-100 transition">info</span>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-max px-3 py-1.5 bg-[#0B2B5E] text-white text-xs rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">Mostra somente resultados e atendimentos da Equipe selecionada.</div>
            </div>

            <div class="relative flex items-center group gap-1">
              <select id="dash-filter-collab" onchange="loadDashboard()" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-700 font-semibold w-44 cursor-pointer focus:border-[#C8A153] focus:ring-[#C8A153]">
                <option value="all">👥 Todos Colab.</option>
              </select>
              <span class="material-symbols-outlined text-[#C8A153] cursor-help text-lg opacity-60 hover:opacity-100 transition">info</span>
              <div class="absolute bottom-full right-0 mb-2 w-max px-3 py-1.5 bg-[#0B2B5E] text-white text-xs rounded shadow-lg opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">Isola os dados para a performance de um Colaborador específico.</div>
            </div>

          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-gradient-to-br from-[#0B2B5E] to-[#153975] p-6 rounded-[20px] shadow-xl shadow-blue-900/20 text-white relative overflow-hidden group">
            <div class="relative z-10">
              <p class="text-sm font-medium opacity-90 tracking-wide text-gray-300">Adoção Global</p>
              <h3 class="text-4xl font-extrabold mt-2 text-[#C8A153]" id="kpi-total">0</h3>
              <p class="text-xs mt-3 text-white flex items-center gap-1 font-semibold"><span class="material-symbols-outlined text-[14px]">trending_up</span> Atendimentos Totais</p>
            </div>
            <span class="material-symbols-outlined absolute -right-2 top-1/2 -translate-y-1/2 text-7xl opacity-10 group-hover:scale-110 transition-transform duration-300">add_circle</span>
          </div>

          <div class="bg-gradient-to-br from-[#C8A153] to-[#b08d46] p-6 rounded-[20px] shadow-xl shadow-yellow-700/20 text-white relative overflow-hidden group">
            <div class="relative z-10">
              <p class="text-sm font-medium opacity-90 tracking-wide text-[#0B2B5E]">TMA Operação</p>
              <h3 class="text-4xl font-extrabold mt-2 text-white"><span id="kpi-tma">0</span><span class="text-xl font-normal opacity-90 ml-1">min</span></h3>
              <p class="text-xs mt-3 text-[#0B2B5E] flex items-center gap-1 font-bold"><span class="material-symbols-outlined text-[14px]">timer</span> Tempo Médio</p>
            </div>
            <span class="material-symbols-outlined absolute -right-2 top-1/2 -translate-y-1/2 text-7xl opacity-20 group-hover:scale-110 transition-transform duration-300 text-[#0B2B5E]">forum</span>
          </div>

          <div class="bg-gradient-to-br from-[#1e293b] to-[#0f172a] p-6 rounded-[20px] shadow-xl shadow-slate-900/30 text-white relative overflow-hidden group">
            <div class="relative z-10">
              <p class="text-sm font-medium opacity-90 tracking-wide text-gray-400">Retenção Diária</p>
              <h3 class="text-4xl font-extrabold mt-2" id="kpi-hoje">0</h3>
              <p class="text-xs mt-3 text-gray-300 flex items-center gap-1 font-semibold"><span class="material-symbols-outlined text-[14px]">today</span> Fluxo Hoje</p>
            </div>
            <span class="material-symbols-outlined absolute -right-2 top-1/2 -translate-y-1/2 text-7xl opacity-20 group-hover:scale-110 transition-transform duration-300 animate-spin-slow text-[#C8A153]">blur_on</span>
          </div>

          <div class="bg-gradient-to-br from-[#174287] to-[#0a234f] p-6 rounded-[20px] shadow-xl shadow-blue-800/20 text-white relative overflow-hidden group">
            <div class="relative z-10">
              <p class="text-sm font-medium opacity-90 tracking-wide text-gray-300">Sistema Destaque</p>
              <h3 class="text-2xl font-extrabold mt-4 truncate text-white" id="kpi-top-sys">-</h3>
              <p class="text-xs mt-3 text-[#C8A153] flex items-center gap-1 font-semibold"><span class="material-symbols-outlined text-[14px]">emoji_events</span> Mais acionado</p>
            </div>
            <span class="material-symbols-outlined absolute -right-2 top-1/2 -translate-y-1/2 text-7xl opacity-10 group-hover:scale-110 transition-transform duration-300">emoji_events</span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="bg-white p-8 rounded-[20px] shadow-lg shadow-gray-200/50 border border-gray-100 flex flex-col items-center relative">
            <h4 class="text-lg font-bold text-[#0B2B5E] w-full flex items-center gap-2 mb-6"><span class="material-symbols-outlined text-[#C8A153]">pie_chart</span> Maior Volume</h4>
            <div class="relative w-full max-w-[280px] aspect-square flex items-end justify-center pb-4">
              <canvas id="chart-sistemas" class="absolute inset-0"></canvas>
              <div class="absolute bottom-8 flex flex-col items-center">
                <span class="text-xs text-gray-400 font-bold uppercase tracking-widest">Liderança</span>
                <span class="text-4xl font-extrabold text-[#0B2B5E] mt-1" id="gauge-center-text">100%</span>
              </div>
            </div>
          </div>

          <div class="bg-white p-8 rounded-[20px] shadow-lg shadow-gray-200/50 border border-gray-100 lg:col-span-2">
            <h4 class="text-lg font-bold text-[#0B2B5E] mb-6 flex items-center gap-2"><span class="material-symbols-outlined text-[#C8A153]">chat</span> Engajamento e Volume</h4>
            <div class="relative h-[260px] w-full">
              <canvas id="chart-evolucao"></canvas>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6">
          <div class="bg-white p-8 rounded-[20px] shadow-lg shadow-gray-200/50 border border-gray-100 relative">
            <div class="flex justify-between items-center mb-8">
              <h4 class="text-lg font-bold text-[#0B2B5E] flex items-center gap-2"><span class="material-symbols-outlined text-[#C8A153]">view_timeline</span> Atendimentos por Categoria</h4>
              <span class="material-symbols-outlined text-[#C8A153] bg-blue-50 p-2 rounded-xl border border-blue-100">camera</span>
            </div>
            <div class="relative h-72 w-full">
              <canvas id="chart-categorias"></canvas>
            </div>
          </div>
        </div>

      </section>

      <section id="atendimentos" class="hidden fade-in max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-[#0B2B5E] mb-8 flex items-center gap-3">
          <span class="material-symbols-outlined text-4xl text-[#C8A153]">support_agent</span> 
          Registro de Atendimento
        </h2>
        <div class="bg-white p-10 rounded-[20px] shadow-xl shadow-gray-200/50 border border-gray-100">
          <form id="form-atendimento" onsubmit="handleAtendimento(event)">
            
            <div class="grid grid-cols-2 gap-8 mb-6">
              <div>
                <label class="block text-xs font-bold text-[#0B2B5E] uppercase tracking-wide mb-2">Solicitante</label>
                <select id="input-solicitante" class="w-full p-3.5 border border-gray-200 rounded-xl bg-gray-50 text-gray-700 font-medium cursor-pointer" required>
                  <option value="">Carregando...</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-[#0B2B5E] uppercase tracking-wide mb-2">Sistema Base</label>
                <select name="sistema" id="input-sistema" onchange="updateSubcategorias()" class="w-full p-3.5 border border-gray-200 rounded-xl bg-gray-50 text-gray-700 font-medium cursor-pointer" required>
                  <option value="" disabled selected>Selecione o Sistema...</option>
