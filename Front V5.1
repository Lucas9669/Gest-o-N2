        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 flex-1 overflow-hidden min-h-[600px]">
          
          <div class="lg:col-span-2 bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 p-6 flex flex-col h-full overflow-y-auto" id="calendar-wrapper">
          </div>

          <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 flex flex-col overflow-hidden h-full">
              
             <div class="p-6 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
               <div>
                 <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest">Resumo do Dia</h3>
                 <p id="selected-date-display" class="text-xl font-extrabold text-[#0B2B5E] mt-1 capitalize">Selecione um dia</p>
