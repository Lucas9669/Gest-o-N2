                  <h4 class="text-xs font-bold text-red-600 uppercase tracking-widest mb-4 flex items-center">
                    <span class="material-symbols-outlined text-[16px] mr-2">pending_actions</span> Em Aberto
                  </h4>
                  <div id="list-open" class="space-y-3 flex-1">
                    <p class="text-sm text-gray-400 font-medium italic">Nenhuma pendência para este dia.</p>
                  </div>
               </div>

               <div class="flex-1 p-6 flex flex-col">
                  <h4 class="text-xs font-bold text-emerald-600 uppercase tracking-widest mb-4 flex items-center">
                    <span class="material-symbols-outlined text-[16px] mr-2">check_circle</span> Concluídos
                  </h4>
                  <div id="list-done" class="space-y-3 flex-1">
                    <p class="text-sm text-gray-400 font-medium italic">Nenhum registro concluído.</p>
                  </div>
               </div>

             </div>
